@page "/glossary-request-details/{Id:int}"
@using Transcription.Models
@using Microsoft.EntityFrameworkCore
@using Transcription.Services
@inject AppDbContext DbContext
@inject AuthService AuthService
@inject NavigationManager navigationManager

<MudCard Elevation="2">
    <MudCardContent>
        <MudText Typo="Typo.h4" Class="mb-4">№ заявки: @glossaryRequest?.Id</MudText>

        @if (glossaryRequest != null)
        {
            <MudStack Spacing="2">
                <MudText><strong>Термин:</strong> @(glossaryRequest.Term ?? "Не указано")</MudText>
                <MudText><strong>Описание термина:</strong> @(glossaryRequest.Description ?? "Не указано")</MudText>
                <MudText><strong>Статус заявки:</strong> @RequestStatusToNormal(glossaryRequest.Status)</MudText>
                <MudText><strong>Дата создания:</strong> @(glossaryRequest.CreatedAt.ToString("dd.MM.yyyy HH:mm"))</MudText>
            </MudStack>
        }
    </MudCardContent>
    <MudCardActions>
        <MudStack Row="true" Spacing="2">
            @if (glossaryRequest?.Status == Enums.GlossaryRequestStatuses.Sent)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="MarkAsAccepted">Принять</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="MarkAsRejected">Отклонить</MudButton>
            }
            <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="GoBack">Назад</MudButton>
        </MudStack>
    </MudCardActions>
</MudCard>

@code {
    [Parameter] public int Id { get; set; }
    public GlossaryRequest? glossaryRequest;

    private async Task MarkAsAccepted()
    {
        if (AuthService.CurrentUser?.IsAdmin != true) return;
        if (glossaryRequest != null)
        {
            glossaryRequest.Status = Enums.GlossaryRequestStatuses.Accepted;
            await DbContext.SaveChangesAsync();
            await OnParametersSetAsync();
        }
    }

    private async Task MarkAsRejected()
    {
        if (AuthService.CurrentUser?.IsAdmin != true) return;
        if (glossaryRequest != null)
        {
            glossaryRequest.Status = Enums.GlossaryRequestStatuses.Rejected;
            await DbContext.SaveChangesAsync();
            await OnParametersSetAsync();
        }
    }

    private void GoBack()
    {
        if (AuthService.CurrentUser.IsAdmin)
            navigationManager.NavigateTo("/admin-panel");
        else
            navigationManager.NavigateTo("/my-requests");
    }

    protected override async Task OnParametersSetAsync()
    {
        glossaryRequest = await DbContext.GlossaryRequests.Include(r => r.User).FirstOrDefaultAsync(r => r.Id == Id);
    }

    private string RequestStatusToNormal(Enums.GlossaryRequestStatuses? status) => status switch
    {
        Enums.GlossaryRequestStatuses.Sent => "Отправлено",
        Enums.GlossaryRequestStatuses.Accepted => "Принято",
        Enums.GlossaryRequestStatuses.Rejected => "Отклонено",
        _ => "Не указан"
    };
}